# Copy to .env (git-ignored) or set as environment variables / user-secrets. Placeholders only.
POSTGRES_USER=commerce
POSTGRES_PASSWORD=<local-dev-password>
ConnectionStrings__RetrievalDb=Host=localhost;Port=5433;Database=commerce_readiness;Username=commerce;Password=<local-dev-password>
OPENAI_API_KEY=<your-openai-api-key>
Retrieval__EmbeddingModel=text-embedding-3-small
Retrieval__EmbeddingDimensions=1536
# Integration tests (dotnet test --filter Category=Integration):
RETRIEVAL_TEST_DB=Host=localhost;Port=5433;Database=commerce_readiness;Username=commerce;Password=<local-dev-password>
